{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GLOBE Manager",
  "version": "1.0.0",
  "identifier": "com.globe.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GLOBE Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "shadow": true
      },
      {
        "label": "splash",
        "title": "GLOBE Manager",
        "width": 480,
        "height": 320,
        "center": true,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "shadow": true,
        "url": "splash.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "© 2026 GLOBE Résidence Meublée",
    "shortDescription": "Logiciel de gestion GLOBE",
    "longDescription": "Gestion complète d'une résidence meublée : hôtel, restaurant, caisse, stock et personnel.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "fr-FR"
      },
      "nsis": {
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
