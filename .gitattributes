# Force LF on all text files to avoid CRLF issues on Windows builds
* text=auto eol=lf

# Explicitly force LF for files embedded in the Rust binary
docker-compose.yml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.rs text eol=lf
*.html text eol=lf
*.css text eol=lf

# Binaries — no line ending conversion
*.png binary
*.ico binary
*.exe binary
*.dll binary
