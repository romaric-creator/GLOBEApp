generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ========================
// Authentification
// ========================

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String
  nom                String
  prenom             String
  telephone          String?
  actif              Boolean   @default(true)
  tentativesEchouees Int       @default(0)
  dernierLogin       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  sessions       Session[]
  logsConnexion  LogConnexion[]
  ventes         Vente[]
  cloturesCaisse ClotureCaisse[]
  employe        Employe?
  commandes      CommandeTable[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  nom         String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  accessToken  String
  refreshToken String
  ip           String?
  device       String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum LogAction {
  LOGIN
  LOGOUT
  ECHEC
  REFRESH
}

model LogConnexion {
  id      String    @id @default(uuid()) @db.Uuid
  action  LogAction
  ip      String?
  device  String?
  date    DateTime  @default(now())
  details String?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("logs_connexion")
}

// ========================
// Produits & Stock
// ========================

model Categorie {
  id          String  @id @default(uuid()) @db.Uuid
  nom         String
  description String?

  parentId String?    @db.Uuid
  parent   Categorie? @relation("CategorieHierarchie", fields: [parentId], references: [id])
  enfants  Categorie[] @relation("CategorieHierarchie")

  produits Produit[]

  @@map("categories")
}

model Produit {
  id          String  @id @default(uuid()) @db.Uuid
  reference   String  @unique
  nom         String
  prixAchat   Decimal @db.Decimal(10, 2)
  prixVente   Decimal @db.Decimal(10, 2)
  stockActuel Int     @default(0)
  seuilAlerte Int     @default(5)
  unite       String  @default("unite")
  actif       Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categorieId String @db.Uuid
  categorie   Categorie @relation(fields: [categorieId], references: [id])

  mouvementsStock   MouvementStock[]
  lignesVente       LigneVente[]
  lignesBonCommande LigneBonCommande[]

  @@index([categorieId])
  @@index([actif])
  @@map("produits")
}

enum TypeMouvement {
  ENTREE
  SORTIE
  AJUSTEMENT
  INVENTAIRE
}

model MouvementStock {
  id       String        @id @default(uuid()) @db.Uuid
  type     TypeMouvement
  quantite Int
  motif    String?
  date     DateTime      @default(now())

  produitId String @db.Uuid
  produit   Produit @relation(fields: [produitId], references: [id])

  @@index([produitId])
  @@index([date])
  @@map("mouvements_stock")
}

model Fournisseur {
  id        String  @id @default(uuid()) @db.Uuid
  nom       String
  telephone String?
  email     String?
  adresse   String?
  actif     Boolean @default(true)
  createdAt DateTime @default(now())

  bonsCommande BonCommande[]

  @@map("fournisseurs")
}

enum StatutBonCommande {
  BROUILLON
  ENVOYE
  RECU
  ANNULE
}

model BonCommande {
  id     String            @id @default(uuid()) @db.Uuid
  numero String            @unique
  date   DateTime          @default(now())
  statut StatutBonCommande @default(BROUILLON)
  total  Decimal           @db.Decimal(10, 2) @default(0)

  fournisseurId String @db.Uuid
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])

  lignes LigneBonCommande[]

  @@map("bons_commande")
}

model LigneBonCommande {
  id           String  @id @default(uuid()) @db.Uuid
  quantite     Int
  prixUnitaire Decimal @db.Decimal(10, 2)

  bonCommandeId String @db.Uuid
  bonCommande   BonCommande @relation(fields: [bonCommandeId], references: [id], onDelete: Cascade)

  produitId String @db.Uuid
  produit   Produit @relation(fields: [produitId], references: [id])

  @@map("lignes_bon_commande")
}

// ========================
// Ventes & Caisse
// ========================

enum ModePaiement {
  ESPECES
  CARTE
  VIREMENT
  CREDIT
  MIXTE
}

enum StatutVente {
  EN_COURS
  VALIDEE
  ANNULEE
  REMBOURSEE
}

model Vente {
  id            String       @id @default(uuid()) @db.Uuid
  numero        String       @unique
  date          DateTime     @default(now())
  sousTotal     Decimal      @db.Decimal(10, 2) @default(0)
  remise        Decimal      @db.Decimal(10, 2) @default(0)
  taxe          Decimal      @db.Decimal(10, 2) @default(0)
  total         Decimal      @db.Decimal(10, 2) @default(0)
  modePaiement  ModePaiement @default(ESPECES)
  statut        StatutVente  @default(EN_COURS)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  clientId String? @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id])

  lignes    LigneVente[]
  ticket    Ticket?
  avoir     Avoir?
  creances  Creance[]
  livraison Livraison?

  @@index([userId])
  @@index([clientId])
  @@index([date])
  @@index([statut])
  @@map("ventes")
}

model LigneVente {
  id           String  @id @default(uuid()) @db.Uuid
  quantite     Int
  prixUnitaire Decimal @db.Decimal(10, 2)
  remise       Decimal @db.Decimal(10, 2) @default(0)
  totalLigne   Decimal @db.Decimal(10, 2)

  venteId String @db.Uuid
  vente   Vente  @relation(fields: [venteId], references: [id], onDelete: Cascade)

  produitId String @db.Uuid
  produit   Produit @relation(fields: [produitId], references: [id])

  @@index([venteId])
  @@index([produitId])
  @@map("lignes_vente")
}

model Ticket {
  id           String  @id @default(uuid()) @db.Uuid
  numeroTicket String  @unique
  contenu      String
  imprime      Boolean @default(false)
  createdAt    DateTime @default(now())

  venteId String @unique @db.Uuid
  vente   Vente  @relation(fields: [venteId], references: [id])

  @@map("tickets")
}

model Avoir {
  id      String   @id @default(uuid()) @db.Uuid
  motif   String
  montant Decimal  @db.Decimal(10, 2)
  date    DateTime @default(now())

  venteId String @unique @db.Uuid
  vente   Vente  @relation(fields: [venteId], references: [id])

  @@map("avoirs")
}

model ClotureCaisse {
  id               String   @id @default(uuid()) @db.Uuid
  date             DateTime @default(now())
  montantOuverture Decimal  @db.Decimal(10, 2)
  montantCloture   Decimal  @db.Decimal(10, 2)
  ecart            Decimal  @db.Decimal(10, 2) @default(0)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@map("clotures_caisse")
}

// ========================
// Clients
// ========================

enum TypeClient {
  PARTICULIER
  PROFESSIONNEL
}

model Client {
  id             String     @id @default(uuid()) @db.Uuid
  type           TypeClient @default(PARTICULIER)
  nom            String
  prenom         String?
  raisonSociale  String?
  telephone      String?
  email          String?
  soldeCreance   Decimal    @db.Decimal(10, 2) @default(0)
  pointsFidelite Int        @default(0)
  actif          Boolean    @default(true)
  createdAt      DateTime   @default(now())

  ventes                  Vente[]
  creances                Creance[]
  reservations            Reservation[]
  ticketsPiscine          TicketPiscine[]
  abonnementsLoisir       AbonnementLoisir[]
  reservationsSalle       ReservationSalle[]
  transactionsAccessoire  TransactionAccessoire[]

  @@map("clients")
}

enum StatutCreance {
  EN_COURS
  PAYEE
  EN_RETARD
  ANNULEE
}

model Creance {
  id           String        @id @default(uuid()) @db.Uuid
  montant      Decimal       @db.Decimal(10, 2)
  dateEcheance DateTime      @db.Date
  statut       StatutCreance @default(EN_COURS)
  createdAt    DateTime      @default(now())

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id])

  venteId String @db.Uuid
  vente   Vente  @relation(fields: [venteId], references: [id])

  @@index([clientId])
  @@index([statut])
  @@map("creances")
}

// ========================
// Personnel
// ========================

enum TypeContrat {
  CDI
  CDD
  STAGE
  FREELANCE
}

model Employe {
  id          String     @id @default(uuid()) @db.Uuid
  matricule   String     @unique
  nom         String
  prenom      String
  poste       String
  salaire     Decimal    @db.Decimal(10, 2)
  typeContrat TypeContrat
  actif       Boolean    @default(true)
  createdAt   DateTime   @default(now())

  userId String? @unique @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  empreintes Empreinte[]
  pointages  Pointage[]
  conges     Conge[]

  @@map("employes")
}

enum DoigtEmpreinte {
  POUCE_DROIT
  INDEX_DROIT
  MAJEUR_DROIT
  POUCE_GAUCHE
  INDEX_GAUCHE
}

model Empreinte {
  id           String         @id @default(uuid()) @db.Uuid
  templateData Bytes
  doigt        DoigtEmpreinte
  createdAt    DateTime       @default(now())

  employeId String @db.Uuid
  employe   Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@map("empreintes")
}

enum MethodePointage {
  BIOMETRIQUE
  MANUEL
}

model Pointage {
  id           String          @id @default(uuid()) @db.Uuid
  date         DateTime        @db.Date
  heureArrivee DateTime?       @db.Time()
  heureDepart  DateTime?       @db.Time()
  methode      MethodePointage @default(BIOMETRIQUE)

  employeId String @db.Uuid
  employe   Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@index([employeId])
  @@index([date])
  @@map("pointages")
}

enum TypeConge {
  ANNUEL
  MALADIE
  SANS_SOLDE
  MATERNITE
  EXCEPTIONNEL
}

enum StatutConge {
  EN_ATTENTE
  APPROUVE
  REFUSE
  ANNULE
}

model Conge {
  id        String      @id @default(uuid()) @db.Uuid
  type      TypeConge
  dateDebut DateTime    @db.Date
  dateFin   DateTime    @db.Date
  statut    StatutConge @default(EN_ATTENTE)
  motif     String?
  createdAt DateTime    @default(now())

  employeId String @db.Uuid
  employe   Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@map("conges")
}

// ========================
// Comptabilite
// ========================

enum TypeCompte {
  ACTIF
  PASSIF
  CHARGE
  PRODUIT
}

model Compte {
  id    String    @id @default(uuid()) @db.Uuid
  nom   String
  type  TypeCompte
  solde Decimal   @db.Decimal(12, 2) @default(0)

  ecrituresDebit  Ecriture[] @relation("EcritureDebit")
  ecrituresCredit Ecriture[] @relation("EcritureCredit")

  @@map("comptes")
}

model Ecriture {
  id      String   @id @default(uuid()) @db.Uuid
  date    DateTime @default(now())
  montant Decimal  @db.Decimal(12, 2)
  libelle String

  compteDebitId  String @db.Uuid
  compteDebit    Compte @relation("EcritureDebit", fields: [compteDebitId], references: [id])

  compteCreditId String @db.Uuid
  compteCredit   Compte @relation("EcritureCredit", fields: [compteCreditId], references: [id])

  categorieComptaId String @db.Uuid
  categorieCompta   CategorieCompta @relation(fields: [categorieComptaId], references: [id])

  @@index([date])
  @@index([compteDebitId])
  @@index([compteCreditId])
  @@map("ecritures")
}

enum TypeCategorieCompta {
  RECETTE
  DEPENSE
  TRANSFERT
}

model CategorieCompta {
  id   String              @id @default(uuid()) @db.Uuid
  nom  String
  type TypeCategorieCompta

  ecritures Ecriture[]

  @@map("categories_compta")
}

model Cloture {
  id          String   @id @default(uuid()) @db.Uuid
  periode     String
  dateCloture DateTime @default(now())
  valide      Boolean  @default(false)

  @@map("clotures")
}

// ========================
// Sauvegarde
// ========================

enum TypeSauvegarde {
  COMPLETE
  INCREMENTALE
}

enum StatutSauvegarde {
  EN_COURS
  REUSSIE
  ECHOUEE
}

model Sauvegarde {
  id     String           @id @default(uuid()) @db.Uuid
  date   DateTime         @default(now())
  taille BigInt?
  chemin String
  type   TypeSauvegarde
  statut StatutSauvegarde @default(EN_COURS)

  @@map("sauvegardes")
}

// ========================
// Hotel (Module Optionnel)
// ========================

enum TypeChambre {
  SIMPLE
  DOUBLE
  SUITE
  VIP
}

enum StatutChambre {
  DISPONIBLE
  OCCUPEE
  MAINTENANCE
  RESERVEE
}

model Chambre {
  id        String       @id @default(uuid()) @db.Uuid
  numero    String       @unique
  type      TypeChambre
  statut    StatutChambre @default(DISPONIBLE)
  prixNuit  Decimal      @db.Decimal(10, 2)
  etage     Int?
  capacite  Int          @default(2)
  createdAt DateTime     @default(now())

  reservations Reservation[]

  @@map("chambres")
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  EN_COURS
  TERMINEE
  ANNULEE
}

model Reservation {
  id           String            @id @default(uuid()) @db.Uuid
  dateArrivee  DateTime          @db.Date
  dateDepart   DateTime          @db.Date
  nbPersonnes  Int               @default(1)
  statut       StatutReservation @default(EN_ATTENTE)
  montantTotal Decimal           @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime          @default(now())

  chambreId String @db.Uuid
  chambre   Chambre @relation(fields: [chambreId], references: [id])

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id])

  factureSejour FactureSejour?

  @@index([chambreId])
  @@index([clientId])
  @@index([statut])
  @@map("reservations")
}

model FactureSejour {
  id            String   @id @default(uuid()) @db.Uuid
  numero        String   @unique
  montantNuitee Decimal  @db.Decimal(10, 2)
  montantExtras Decimal  @db.Decimal(10, 2) @default(0)
  total         Decimal  @db.Decimal(10, 2)
  payee         Boolean  @default(false)
  createdAt     DateTime @default(now())

  reservationId String      @unique @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@map("factures_sejour")
}

// ========================
// Bar & Restauration (Module Optionnel)
// ========================

enum CategorieArticle {
  BOISSON
  PLAT
  DESSERT
  AUTRE
}

model ArticleMenu {
  id          String            @id @default(uuid()) @db.Uuid
  nom         String
  description String?
  categorie   CategorieArticle  @default(AUTRE)
  prix        Decimal           @db.Decimal(10, 2)
  actif       Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lignes LigneCommande[]

  @@map("articles_menu")
}

enum StatutTable {
  LIBRE
  OCCUPEE
  RESERVEE
}

model TableRestaurant {
  id       String     @id @default(uuid()) @db.Uuid
  numero   Int        @unique
  capacite Int
  zone     String?
  statut   StatutTable @default(LIBRE)

  commandes CommandeTable[]

  @@map("tables_restaurant")
}

enum StatutCommande {
  EN_ATTENTE
  EN_PREPARATION
  PRETE
  SERVIE
  PAYEE
  ANNULEE
}

model CommandeTable {
  id        String         @id @default(uuid()) @db.Uuid
  numero    String         @unique
  statut    StatutCommande @default(EN_ATTENTE)
  total     Decimal        @db.Decimal(10, 2) @default(0)
  notes     String?
  createdAt DateTime       @default(now())

  tableId String? @db.Uuid
  table   TableRestaurant? @relation(fields: [tableId], references: [id])

  serveurId String @db.Uuid
  serveur   User   @relation(fields: [serveurId], references: [id])

  lignes LigneCommande[]

  @@index([tableId])
  @@index([statut])
  @@index([createdAt])
  @@map("commandes_table")
}

model LigneCommande {
  id           String  @id @default(uuid()) @db.Uuid
  quantite     Int
  prixUnitaire Decimal @db.Decimal(10, 2)
  notes        String?

  commandeId String @db.Uuid
  commande   CommandeTable @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  articleId String @db.Uuid
  article   ArticleMenu @relation(fields: [articleId], references: [id])

  @@map("lignes_commande")
}

// ========================
// Piscine & Loisirs (Module Optionnel)
// ========================

enum TypeTicketPiscine {
  JOURNALIER
  ABONNEMENT_MENSUEL
  ABONNEMENT_ANNUEL
}

model TicketPiscine {
  id        String            @id @default(uuid()) @db.Uuid
  type      TypeTicketPiscine
  prix      Decimal           @db.Decimal(10, 2)
  dateDebut DateTime          @db.Date
  dateFin   DateTime?         @db.Date
  utilise   Boolean           @default(false)
  createdAt DateTime          @default(now())

  clientId String? @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id])
  @@map("tickets_piscine")
}

model AbonnementLoisir {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  dateDebut DateTime @db.Date
  dateFin   DateTime @db.Date
  prix      Decimal  @db.Decimal(10, 2)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id])

  @@map("abonnements_loisir")
}

enum TypeAccessoire {
  VENTE
  LOCATION
  VENTE_ET_LOCATION
}

model AccessoirePiscine {
  id          String          @id @default(uuid()) @db.Uuid
  nom         String
  description String?
  type        TypeAccessoire  @default(VENTE)
  prixVente   Decimal?        @db.Decimal(10, 2)
  prixLocation Decimal?       @db.Decimal(10, 2)
  stock       Int             @default(0)
  actif       Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  transactions TransactionAccessoire[]

  @@map("accessoires_piscine")
}

enum TypeTransactionAccessoire {
  VENTE
  LOCATION
  RETOUR
}

model TransactionAccessoire {
  id          String                     @id @default(uuid()) @db.Uuid
  type        TypeTransactionAccessoire
  quantite    Int
  prixUnit    Decimal                    @db.Decimal(10, 2)
  total       Decimal                    @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime                   @default(now())

  accessoireId String            @db.Uuid
  accessoire   AccessoirePiscine @relation(fields: [accessoireId], references: [id])

  clientId String? @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id])

  @@map("transactions_accessoire")
}

// ========================
// Livraison (Module Optionnel)
// ========================

enum StatutLivraison {
  EN_ATTENTE
  EN_COURS
  LIVREE
  ECHOUEE
  ANNULEE
}

model Livreur {
  id        String   @id @default(uuid()) @db.Uuid
  nom       String
  prenom    String
  telephone String
  vehicule  String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  livraisons Livraison[]

  @@map("livreurs")
}

model Livraison {
  id            String          @id @default(uuid()) @db.Uuid
  adresse       String
  statut        StatutLivraison @default(EN_ATTENTE)
  fraisLivraison Decimal        @db.Decimal(10, 2) @default(0)
  latitude      Decimal?        @db.Decimal(10, 7)
  longitude     Decimal?        @db.Decimal(10, 7)
  dateLivraison DateTime?
  createdAt     DateTime        @default(now())

  livreurId String @db.Uuid
  livreur   Livreur @relation(fields: [livreurId], references: [id])

  venteId String @unique @db.Uuid
  vente   Vente  @relation(fields: [venteId], references: [id])

  @@map("livraisons")
}

// ========================
// Salle de Fete
// ========================

enum StatutReservationSalle {
  EN_ATTENTE
  CONFIRMEE
  ANNULEE
  TERMINEE
}

model TypeReservationSalle {
  id          String   @id @default(uuid()) @db.Uuid
  nom         String   @unique
  description String?
  inclusions  String?
  prixBase    Decimal  @db.Decimal(10, 2) @default(0)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())

  reservations ReservationSalle[]

  @@map("types_reservation_salle")
}

model ReservationSalle {
  id          String                 @id @default(uuid()) @db.Uuid
  dateEvent   DateTime               @db.Date
  heureDebut  String
  heureFin    String
  nbInvites   Int
  motif       String
  montant     Decimal                @db.Decimal(10, 2)
  statut      StatutReservationSalle @default(EN_ATTENTE)
  notes       String?
  createdAt   DateTime               @default(now())

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id])

  typeId String? @db.Uuid
  type   TypeReservationSalle? @relation(fields: [typeId], references: [id])

  @@map("reservations_salle")
}

// ========================
// Synchronisation Cloud (Module Optionnel)
// ========================

enum StatutSync {
  EN_COURS
  REUSSIE
  ECHOUEE
}

model SyncLog {
  id        String    @id @default(uuid()) @db.Uuid
  statut    StatutSync
  details   String?
  nbEnvois  Int       @default(0)
  nbRecus   Int       @default(0)
  createdAt DateTime  @default(now())

  @@map("sync_logs")
}
