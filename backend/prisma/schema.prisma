generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


// ========================
// Authentification
// ========================

model User {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  email              String    @unique
  passwordHash       String
  nom                String
  prenom             String
  telephone          String?
  actif              Boolean   @default(true)
  tentativesEchouees Int       @default(0)
  dernierLogin       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roleId String @db.VarChar(36)
  role   Role   @relation(fields: [roleId], references: [id])

  sessions         Session[]
  logsConnexion    LogConnexion[]
  employe          Employe?
  commandes        CommandeTable[]
  sessionsOuvertes SessionCaisse[]
  paiements        Paiement[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.VarChar(36)
  nom         String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.VarChar(36)
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.VarChar(36)
  permissionId String @db.VarChar(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(uuid()) @db.VarChar(36)
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  ip           String?
  device       String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  userId String @db.VarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum LogAction {
  LOGIN
  LOGOUT
  ECHEC
  REFRESH
}

model LogConnexion {
  id      String    @id @default(uuid()) @db.VarChar(36)
  action  LogAction
  ip      String?
  device  String?
  date    DateTime  @default(now())
  details String?

  userId String @db.VarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("logs_connexion")
}

// ========================
// Produits & Stock
// ========================

model Categorie {
  id          String  @id @default(uuid()) @db.VarChar(36)
  nom         String
  description String?

  parentId String?     @db.VarChar(36)
  parent   Categorie?  @relation("CategorieHierarchie", fields: [parentId], references: [id])
  enfants  Categorie[] @relation("CategorieHierarchie")

  produits Produit[]

  @@map("categories")
}

model Produit {
  id          String   @id @default(uuid()) @db.VarChar(36)
  reference   String   @unique
  nom         String
  prixAchat   Decimal  @db.Decimal(10, 2)
  prixVente   Decimal  @db.Decimal(10, 2)
  stockActuel Int      @default(0)
  seuilAlerte Int      @default(5)
  unite       String   @default("unite")
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categorieId String    @db.VarChar(36)
  categorie   Categorie @relation(fields: [categorieId], references: [id])

  mouvementsStock   MouvementStock[]
  lignesBonCommande LigneBonCommande[]
  lignesCommande    LigneCommande[]

  @@index([categorieId])
  @@index([actif])
  @@map("produits")
}

enum TypeMouvement {
  ENTREE
  SORTIE
  AJUSTEMENT
  INVENTAIRE
}

model MouvementStock {
  id       String        @id @default(uuid()) @db.VarChar(36)
  type     TypeMouvement
  quantite Int
  motif    String?
  date     DateTime      @default(now())

  produitId String  @db.VarChar(36)
  produit   Produit @relation(fields: [produitId], references: [id])

  @@index([produitId])
  @@index([date])
  @@map("mouvements_stock")
}

model Fournisseur {
  id        String   @id @default(uuid()) @db.VarChar(36)
  nom       String
  telephone String?
  email     String?
  adresse   String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  bonsCommande BonCommande[]

  @@map("fournisseurs")
}

enum StatutBonCommande {
  BROUILLON
  ENVOYE
  RECU
  ANNULE
}

model BonCommande {
  id     String            @id @default(uuid()) @db.VarChar(36)
  numero String            @unique
  date   DateTime          @default(now())
  statut StatutBonCommande @default(BROUILLON)
  total  Decimal           @db.Decimal(10, 2) @default(0)

  fournisseurId String      @db.VarChar(36)
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])

  lignes LigneBonCommande[]

  @@map("bons_commande")
}

model LigneBonCommande {
  id           String  @id @default(uuid()) @db.VarChar(36)
  quantite     Int
  prixUnitaire Decimal @db.Decimal(10, 2)

  bonCommandeId String      @db.VarChar(36)
  bonCommande   BonCommande @relation(fields: [bonCommandeId], references: [id], onDelete: Cascade)

  produitId String  @db.VarChar(36)
  produit   Produit @relation(fields: [produitId], references: [id])

  @@map("lignes_bon_commande")
}

// ========================
// Clients
// ========================

enum TypeClient {
  PARTICULIER
  PROFESSIONNEL
}

model Client {
  id            String     @id @default(uuid()) @db.VarChar(36)
  type          TypeClient @default(PARTICULIER)
  nom           String
  prenom        String?
  raisonSociale String?
  telephone     String?
  email         String?
  pieceIdentite String?
  observations  String?
  actif         Boolean    @default(true)
  createdAt     DateTime   @default(now())

  reservations           Reservation[]
  ticketsPiscine         TicketPiscine[]
  abonnementsLoisir      AbonnementLoisir[]
  reservationsSalle      ReservationSalle[]
  transactionsAccessoire TransactionAccessoire[]

  @@map("clients")
}

// ========================
// Personnel
// ========================

enum TypeContrat {
  CDI
  CDD
  STAGE
  FREELANCE
}

model Employe {
  id          String      @id @default(uuid()) @db.VarChar(36)
  matricule   String      @unique
  nom         String
  prenom      String
  poste       String
  salaire     Decimal     @db.Decimal(10, 2)
  typeContrat TypeContrat
  actif       Boolean     @default(true)
  createdAt   DateTime    @default(now())

  userId String? @unique @db.VarChar(36)
  user   User?   @relation(fields: [userId], references: [id])

  empreintes Empreinte[]
  pointages  Pointage[]
  conges     Conge[]

  @@map("employes")
}

enum DoigtEmpreinte {
  POUCE_DROIT
  INDEX_DROIT
  MAJEUR_DROIT
  POUCE_GAUCHE
  INDEX_GAUCHE
}

model Empreinte {
  id           String         @id @default(uuid()) @db.VarChar(36)
  templateData Bytes @db.LongBlob
  doigt        DoigtEmpreinte
  createdAt    DateTime       @default(now())

  employeId String  @db.VarChar(36)
  employe   Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@map("empreintes")
}

enum MethodePointage {
  BIOMETRIQUE
  MANUEL
}

model Pointage {
  id           String          @id @default(uuid()) @db.VarChar(36)
  date         DateTime        @db.Date
  heureArrivee DateTime?       @db.Time(0)
  heureDepart  DateTime?       @db.Time(0)
  methode      MethodePointage @default(BIOMETRIQUE)

  employeId String  @db.VarChar(36)
  employe   Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@index([employeId])
  @@index([date])
  @@map("pointages")
}

enum TypeConge {
  ANNUEL
  MALADIE
  SANS_SOLDE
  MATERNITE
  EXCEPTIONNEL
}

enum StatutConge {
  EN_ATTENTE
  APPROUVE
  REFUSE
  ANNULE
}

model Conge {
  id        String      @id @default(uuid()) @db.VarChar(36)
  type      TypeConge
  dateDebut DateTime    @db.Date
  dateFin   DateTime    @db.Date
  statut    StatutConge @default(EN_ATTENTE)
  motif     String?
  createdAt DateTime    @default(now())

  employeId String  @db.VarChar(36)
  employe   Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@map("conges")
}

// ========================
// Comptabilite
// ========================

enum TypeCompte {
  ACTIF
  PASSIF
  CHARGE
  PRODUIT
}

model Compte {
  id    String     @id @default(uuid()) @db.VarChar(36)
  nom   String
  type  TypeCompte
  solde Decimal    @db.Decimal(12, 2) @default(0)

  ecrituresDebit  Ecriture[] @relation("EcritureDebit")
  ecrituresCredit Ecriture[] @relation("EcritureCredit")

  @@map("comptes")
}

model Ecriture {
  id      String   @id @default(uuid()) @db.VarChar(36)
  date    DateTime @default(now())
  montant Decimal  @db.Decimal(12, 2)
  libelle String

  compteDebitId String @db.VarChar(36)
  compteDebit   Compte @relation("EcritureDebit", fields: [compteDebitId], references: [id])

  compteCreditId String @db.VarChar(36)
  compteCredit   Compte @relation("EcritureCredit", fields: [compteCreditId], references: [id])

  categorieComptaId String          @db.VarChar(36)
  categorieCompta   CategorieCompta @relation(fields: [categorieComptaId], references: [id])

  @@index([date])
  @@index([compteDebitId])
  @@index([compteCreditId])
  @@map("ecritures")
}

enum TypeCategorieCompta {
  RECETTE
  DEPENSE
  TRANSFERT
}

model CategorieCompta {
  id   String              @id @default(uuid()) @db.VarChar(36)
  nom  String
  type TypeCategorieCompta

  ecritures Ecriture[]

  @@map("categories_compta")
}

model Cloture {
  id          String   @id @default(uuid()) @db.VarChar(36)
  periode     String
  dateCloture DateTime @default(now())
  valide      Boolean  @default(false)

  @@map("clotures")
}

enum CentreDepense {
  HOTEL
  RESTAURANT
  PISCINE
  SALLE_FETE
  GENERAL
}

model Depense {
  id          String        @id @default(uuid()) @db.VarChar(36)
  libelle     String
  montant     Decimal       @db.Decimal(12, 2)
  centre      CentreDepense @default(GENERAL)
  date        DateTime      @default(now())
  notes       String?
  createdAt   DateTime      @default(now())
  syncStatus  SyncStatus    @default(PENDING)
  syncedAt    DateTime?

  @@index([date])
  @@index([centre])
  @@map("depenses")
}

// ========================
// Sauvegarde
// ========================

enum TypeSauvegarde {
  COMPLETE
  INCREMENTALE
}

enum StatutSauvegarde {
  EN_COURS
  REUSSIE
  ECHOUEE
}

model Sauvegarde {
  id     String           @id @default(uuid()) @db.VarChar(36)
  date   DateTime         @default(now())
  taille BigInt?
  chemin String
  type   TypeSauvegarde
  statut StatutSauvegarde @default(EN_COURS)

  @@map("sauvegardes")
}

// ========================
// Hotel
// ========================

enum TypeChambre {
  STANDARD
  JUNIOR
  JUNIOR_PLUS
  SENIOR
  STUDIO
  APPARTEMENT
}

enum StatutChambre {
  DISPONIBLE
  OCCUPEE
  MAINTENANCE
  RESERVEE
}

model Chambre {
  id        String        @id @default(uuid()) @db.VarChar(36)
  numero    String        @unique
  type      TypeChambre
  statut    StatutChambre @default(DISPONIBLE)
  prixNuit  Decimal       @db.Decimal(10, 2)
  etage     Int?
  capacite  Int           @default(2)
  createdAt DateTime      @default(now())

  reservations Reservation[]

  @@map("chambres")
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  EN_COURS
  TERMINEE
  ANNULEE
}

model Reservation {
  id           String            @id @default(uuid()) @db.VarChar(36)
  dateArrivee  DateTime          @db.Date
  dateDepart   DateTime          @db.Date
  nbPersonnes  Int               @default(1)
  statut       StatutReservation @default(EN_ATTENTE)
  montantTotal Decimal           @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime          @default(now())
  syncStatus   SyncStatus        @default(PENDING)
  syncedAt     DateTime?

  chambreId String  @db.VarChar(36)
  chambre   Chambre @relation(fields: [chambreId], references: [id])

  clientId String @db.VarChar(36)
  client   Client @relation(fields: [clientId], references: [id])

  factureSejour FactureSejour?

  @@index([chambreId])
  @@index([clientId])
  @@index([statut])
  @@map("reservations")
}

model FactureSejour {
  id            String     @id @default(uuid()) @db.VarChar(36)
  numero        String     @unique
  montantNuitee Decimal    @db.Decimal(10, 2)
  montantExtras Decimal    @db.Decimal(10, 2) @default(0)
  total         Decimal    @db.Decimal(10, 2)
  montantPaye   Decimal    @db.Decimal(10, 2) @default(0)
  reste         Decimal    @db.Decimal(10, 2) @default(0)
  payee         Boolean    @default(false)
  createdAt     DateTime   @default(now())
  syncStatus    SyncStatus @default(PENDING)
  syncedAt      DateTime?

  reservationId String      @unique @db.VarChar(36)
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  paiement Paiement?

  @@map("factures_sejour")
}

// ========================
// Bar & Restauration
// ========================

enum StatutCommande {
  EN_PREPARATION
  TERMINEE
  ANNULEE
}

model CommandeTable {
  id             String         @id @default(uuid()) @db.VarChar(36)
  numero         String         @unique
  tableReference String?
  statut         StatutCommande @default(EN_PREPARATION)
  total          Decimal        @db.Decimal(10, 2) @default(0)
  notes          String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?
  cancelledAt    DateTime?
  syncStatus     SyncStatus     @default(PENDING)
  syncedAt       DateTime?

  serveurId String @db.VarChar(36)
  serveur   User   @relation(fields: [serveurId], references: [id])

  lignes   LigneCommande[]
  paiement Paiement?

  @@index([statut])
  @@index([createdAt])
  @@map("commandes_table")
}

model LigneCommande {
  id           String  @id @default(uuid()) @db.VarChar(36)
  quantite     Int
  prixUnitaire Decimal @db.Decimal(10, 2)
  notes        String?

  commandeId String        @db.VarChar(36)
  commande   CommandeTable @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  produitId String  @db.VarChar(36)
  produit   Produit @relation(fields: [produitId], references: [id])

  @@map("lignes_commande")
}

// ========================
// Piscine & Loisirs
// ========================

enum TypeTicketPiscine {
  JOURNALIER
  ABONNEMENT_MENSUEL
  ABONNEMENT_ANNUEL
}

model TicketPiscine {
  id        String            @id @default(uuid()) @db.VarChar(36)
  type      TypeTicketPiscine
  prix      Decimal           @db.Decimal(10, 2)
  dateDebut DateTime          @db.Date
  dateFin   DateTime?         @db.Date
  utilise   Boolean           @default(false)
  createdAt DateTime          @default(now())

  clientId String? @db.VarChar(36)
  client   Client? @relation(fields: [clientId], references: [id])

  @@map("tickets_piscine")
}

model AbonnementLoisir {
  id        String   @id @default(uuid()) @db.VarChar(36)
  type      String
  dateDebut DateTime @db.Date
  dateFin   DateTime @db.Date
  prix      Decimal  @db.Decimal(10, 2)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  clientId String @db.VarChar(36)
  client   Client @relation(fields: [clientId], references: [id])

  @@map("abonnements_loisir")
}

enum TypeAccessoire {
  VENTE
  LOCATION
  VENTE_ET_LOCATION
}

model AccessoirePiscine {
  id           String         @id @default(uuid()) @db.VarChar(36)
  nom          String
  description  String?
  type         TypeAccessoire @default(VENTE)
  prixVente    Decimal?       @db.Decimal(10, 2)
  prixLocation Decimal?       @db.Decimal(10, 2)
  stock        Int            @default(0)
  actif        Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  transactions TransactionAccessoire[]

  @@map("accessoires_piscine")
}

enum TypeTransactionAccessoire {
  VENTE
  LOCATION
  RETOUR
}

model TransactionAccessoire {
  id        String                    @id @default(uuid()) @db.VarChar(36)
  type      TypeTransactionAccessoire
  quantite  Int
  prixUnit  Decimal                   @db.Decimal(10, 2)
  total     Decimal                   @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime                  @default(now())

  accessoireId String            @db.VarChar(36)
  accessoire   AccessoirePiscine @relation(fields: [accessoireId], references: [id])

  clientId String? @db.VarChar(36)
  client   Client? @relation(fields: [clientId], references: [id])

  @@map("transactions_accessoire")
}

// ========================
// Salle de Fete
// ========================

enum StatutReservationSalle {
  EN_ATTENTE
  CONFIRMEE
  ANNULEE
  TERMINEE
}

model TypeReservationSalle {
  id          String   @id @default(uuid()) @db.VarChar(36)
  nom         String   @unique
  description String?
  inclusions  String?
  prixBase    Decimal  @db.Decimal(10, 2) @default(0)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())

  reservations ReservationSalle[]

  @@map("types_reservation_salle")
}

model ReservationSalle {
  id         String                 @id @default(uuid()) @db.VarChar(36)
  dateEvent  DateTime               @db.Date
  heureDebut String
  heureFin   String
  nbInvites  Int
  motif      String
  montant    Decimal                @db.Decimal(10, 2)
  statut     StatutReservationSalle @default(EN_ATTENTE)
  notes      String?
  createdAt  DateTime               @default(now())

  clientId String @db.VarChar(36)
  client   Client @relation(fields: [clientId], references: [id])

  typeId String?               @db.VarChar(36)
  type   TypeReservationSalle? @relation(fields: [typeId], references: [id])

  @@map("reservations_salle")
}

// ========================
// Synchronisation Cloud
// ========================

enum StatutSync {
  EN_COURS
  REUSSIE
  ECHOUEE
}

enum SyncStatus {
  PENDING
  SYNCED
}

model SyncLog {
  id           String     @id @default(uuid()) @db.VarChar(36)
  statut       StatutSync
  details      String?
  nbEnvois     Int        @default(0)
  nbRecus      Int        @default(0)
  erreur       String?
  createdAt    DateTime   @default(now())
  completedAt  DateTime?

  @@map("sync_logs")
}

// ========================
// Caisses
// ========================

enum TypeCaisse {
  HOTEL
  RESTAURANT_BAR
}

model Caisse {
  id    String     @id @default(uuid()) @db.VarChar(36)
  nom   String
  type  TypeCaisse
  actif Boolean    @default(true)

  sessions SessionCaisse[]

  @@map("caisses")
}

enum StatutSessionCaisse {
  OUVERTE
  FERMEE
}

model SessionCaisse {
  id             String              @id @default(uuid()) @db.VarChar(36)
  fondInitial    Decimal             @db.Decimal(10, 2) @default(0)
  totalTheorique Decimal             @db.Decimal(10, 2) @default(0)
  totalReel      Decimal             @db.Decimal(10, 2) @default(0)
  ecart          Decimal             @db.Decimal(10, 2) @default(0)
  statut         StatutSessionCaisse @default(OUVERTE)
  ouvertureAt    DateTime            @default(now())
  fermetureAt    DateTime?
  notes          String?

  caisseId String @db.VarChar(36)
  caisse   Caisse @relation(fields: [caisseId], references: [id])

  userId String @db.VarChar(36)
  user   User   @relation(fields: [userId], references: [id])

  paiements Paiement[]

  @@index([caisseId])
  @@index([statut])
  @@map("sessions_caisse")
}

enum MoyenPaiement {
  ESPECES
  CARTE
  VIREMENT
  MOBILE_MONEY
  AUTRE
}

enum SourcePaiement {
  HOTEL_INVOICE
  RESTAURANT_ORDER
  SERVICE
}

enum StatutPaiement {
  EN_ATTENTE
  ENCAISSE
  REMBOURSE
}

model Paiement {
  id         String         @id @default(uuid()) @db.VarChar(36)
  reference  String         @unique
  montant    Decimal        @db.Decimal(10, 2)
  moyen      MoyenPaiement  @default(ESPECES)
  sourceType SourcePaiement
  statut     StatutPaiement @default(ENCAISSE)
  notes      String?
  createdAt  DateTime       @default(now())
  syncStatus SyncStatus     @default(PENDING)
  syncedAt   DateTime?

  sessionId String        @db.VarChar(36)
  session   SessionCaisse @relation(fields: [sessionId], references: [id])

  userId String @db.VarChar(36)
  user   User   @relation(fields: [userId], references: [id])

  factureSejourId String?        @unique @db.VarChar(36)
  factureSejour   FactureSejour? @relation(fields: [factureSejourId], references: [id])

  commandeTableId String?        @unique @db.VarChar(36)
  commandeTable   CommandeTable? @relation(fields: [commandeTableId], references: [id])

  @@index([sessionId])
  @@index([sourceType])
  @@index([createdAt])
  @@map("paiements")
}
