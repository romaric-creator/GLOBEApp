# ── Base de données ───────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PASSWORD=change_me_globe_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 48
JWT_SECRET=change_me_with_a_long_random_string_min_32_chars

# ── CORS (optionnel) ─────────────────────────────────────────────────────────
# Origines supplémentaires autorisées, séparées par des virgules
# Ex: http://192.168.1.10:3000,http://mon-serveur.local:3000
ALLOWED_ORIGINS=

# ── Synchronisation cloud (optionnel) ────────────────────────────────────────
SYNC_REMOTE_URL=
SYNC_API_KEY=
